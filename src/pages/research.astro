---
import Base from "../layouts/Base.astro";
---

<Base title="Research | Peace Ayegba"
  ><header class="inner-banner">
    <div class="container inner-banner-grid">
      <div>
        <div class="eyebrow">Areas & publications</div><h1>Research</h1>
      </div><p>Optimisation and algorithms, applied AI and machine learning.</p>
    </div>
  </header><main class="container inner-main">
    <div class="areas">
      <article class="area-card">
        <svg viewBox="0 0 55 29" width="55" height="29" aria-hidden="true"
          ><path
            d="M7 6L28 14L48 6M7 23L28 14L48 23"
            stroke="#b38b59"
            stroke-width="1.7"
            fill="none"></path><g fill="#173e5c"
            ><circle cx="7" cy="6" r="4"></circle><circle cx="7" cy="23" r="4"
            ></circle><circle cx="28" cy="14" r="4"></circle><circle
              cx="48"
              cy="6"
              r="4"></circle><circle cx="48" cy="23" r="4"></circle></g
          ></svg
        ><h3>Optimisation & Algorithms</h3><p>
          I enjoy working on optimisation problems, determining their
          computational complexity and creating clever solutions for them.
        </p>
      </article><article class="area-card">
        <svg viewBox="0 0 52 29" width="52" height="29" aria-hidden="true"
          ><path
            d="M10 14L40 6M10 14L40 23M40 6V23"
            stroke="#b38b59"
            stroke-width="1.7"
            fill="none"></path><g fill="#173e5c"
            ><circle cx="10" cy="14" r="5"></circle><circle cx="40" cy="6" r="5"
            ></circle><circle cx="40" cy="23" r="5"></circle></g
          ></svg
        ><h3>AI & Machine Learning</h3><p>
          I'm also interested in machine learning and its applications to
          computational problems.
        </p>
      </article>
    </div><section class="publications">
      <div class="eyebrow">Publications</div><h2>Selected Publications</h2><div
        class="publication"
      >
        <h3>Structural Aspects of the Student–Project Allocation Problem</h3><p>
          Discrete Applied Mathematics · P. Ayegba, S. Olaosebikan and D.
          Manlove
        </p><a
          href="https://www.sciencedirect.com/science/article/pii/S0166218X25006110?via%3Dihub"
          target="_blank"
          rel="noopener noreferrer">Read paper ↗</a
        >
      </div><div class="publication">
        <h3>
          The Metarotation Poset for the Student–Project Allocation Problem
        </h3><p>P. Ayegba and S. Olaosebikan</p><a
          href="https://link.springer.com/chapter/10.1007/978-3-032-34519-6_34"
          target="
          _blank"
          rel="noopener noreferrer">Read paper ↗</a
        >
      </div><div class="publication">
        <h3>
          Preliminary Study of Resource Allocation in Wireless Communications
        </h3><p>Euro-Par · 2022</p><a
          href="https://link.springer.com/chapter/10.1007/978-3-031-31209-0_22"
          target="_blank"
          rel="noopener noreferrer">Read paper ↗</a
        >
      </div>
    </section>
  </main></Base
>
