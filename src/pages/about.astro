---
import Base from "../layouts/Base.astro";
---

<Base title="About | Peace Ayegba"
  ><header class="inner-banner">
    <div class="container inner-banner-grid">
      <div>
        <div class="eyebrow">A little more about me</div><h1>About Me</h1>
      </div><p>
        A bit about my research, the things I enjoy and what I do outside
        academia.
      </p>
    </div>
  </header><main class="container inner-main">
    <section class="about-grid">
      <div class="about-copy">
        <p>
          I have a PhD in Computing Science from the University of Glasgow,
          where I considered the structure and complexity of stable matching
          problems and developed new efficient algorithms for solving them.
        </p><p>
          I enjoy solving hard computational problems and exploring different
          approaches to them. My research is mainly in optimisation and
          algorithms, and I'm also interested in applied AI research.
        </p>
      </div><div class="photo-placeholder">
        <img src="/images/group.png" alt="My research group" />
      </div>
    </section><section class="community">
      <div class="eyebrow">Outside research</div><h2>
        Community & Mentoring
      </h2><p>
        I volunteer as a Programme Coordinator for CSA Africa and mentor Year
        10–12 students with Generating Genius. I also enjoy reading science
        fiction and <strong><em>walking a lot</em></strong>.
      </p>
    </section>
  </main></Base
>
