---
import Base from "../layouts/Base.astro";

const posts = Object.values(import.meta.glob("./writing/*.md", { eager: true }))
  .map((p: any) => ({
    frontmatter: p.frontmatter,
    url: p.url,
  }))
  .sort((a, b) =>
    String(b.frontmatter.date).localeCompare(String(a.frontmatter.date)),
  )
  .slice(0, 2);

const projects = [
  {
    tag: "Graph algorithms",
    title: "Minimum Spanning Trees",
    description: "Implementing and comparing Prim's and Kruskal's algorithms.",
    url: "https://github.com/PeaceAyegba/MST-Algorithms",
    label: "View project",
  },
  {
    tag: "Machine learning",
    title: "House Rent Prediction",
    description: "Regression modelling and exploratory data analysis.",
    url: "https://github.com/PeaceAyegba/house-rent-prediction",
    label: "View project",
  },
  {
    tag: "NLP",
    title: "Transformer Fine-Tuning",
    description: "RoBERTa for text classification.",
    url: "https://www.kaggle.com/code/peace1a/roberta-base",
    label: "View notebook",
  },
];
---

<Base>
  <!-- Homepage introduction -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="eyebrow">Research Scientist · Optimisation · Algorithms</div>

      <h1>Peace <span>Ayegba.</span></h1>

      <p>
        I'm a research scientist interested in mathematical optimisation,
        algorithms, artificial intelligence and machine learning. I enjoy
        solving hard problems, exploring new ideas and sharing things I find
        interesting. This is where I share my research, personal projects and
        writing.
      </p>

      <div class="hero-actions">
        <a class="btn" href="/about/">About me ↗</a>
        <a class="hero-link" href="/writing/">Writing & Ideas ↗</a>
      </div>
    </div>
  </section>

  <main>
    <!-- About me -->
    <section class="container section about-home">
      <div class="about-grid">
        <div>
          <div class="eyebrow">About me</div>
          <h2>A little about me.</h2>

          <p>
            I have a PhD in Computing Science from the University of Glasgow,
            where my research focused on stable matching problems, their
            mathematical structure, computational complexity and algorithms for
            solving them.
          </p>

          <p>
            Outside my research, I volunteer as a Programme Coordinator for CSA
            Africa and mentor Year 10–12 students with Generating Genius.
          </p>

          <a class="inline-link" href="/about/">Read more ↗</a>
        </div>
        <!-- My conference photograph -->
        <div class="photo-placeholder">
          <img
            src="/images/me.png"
            alt="Me at a conference"
            loading="lazy"
            style="width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 5px;"
          />
        </div>
      </div>
    </section>

    <!-- Research -->
    <section class="light">
      <div class="container section">
        <div class="section-heading">
          <div>
            <div class="eyebrow">What I work on</div>
            <h2>Research</h2>
          </div>

          <a class="inline-link" href="/research/">
            Research & publications ↗
          </a>
        </div>

        <div class="areas">
          <article class="area-card">
            <svg viewBox="0 0 55 29" width="55" height="29" aria-hidden="true">
              <path
                d="M7 6L28 14L48 6M7 23L28 14L48 23"
                stroke="#b38b59"
                stroke-width="1.7"
                fill="none"></path>
              <g fill="#173e5c">
                <circle cx="7" cy="6" r="4"></circle>
                <circle cx="7" cy="23" r="4"></circle>
                <circle cx="28" cy="14" r="4"></circle>
                <circle cx="48" cy="6" r="4"></circle>
                <circle cx="48" cy="23" r="4"></circle>
              </g>
            </svg>

            <h3>Optimisation & Algorithms</h3>
            <p>
              Stable matching, graph algorithms, combinatorial optimisation and
              computational complexity.
            </p>
          </article>

          <article class="area-card">
            <svg viewBox="0 0 52 29" width="52" height="29" aria-hidden="true">
              <path
                d="M10 14L40 6M10 14L40 23M40 6V23"
                stroke="#b38b59"
                stroke-width="1.7"
                fill="none"></path>
              <g fill="#173e5c">
                <circle cx="10" cy="14" r="5"></circle>
                <circle cx="40" cy="6" r="5"></circle>
                <circle cx="40" cy="23" r="5"></circle>
              </g>
            </svg>

            <h3>AI & Machine Learning</h3>
            <p>
              Machine learning and its applications to mathematical and
              computational problems.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Personal projects -->
    <section class="container section">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Things I've built</div>
          <h2>Personal Projects</h2>
        </div>

        <a class="inline-link" href="/projects/">All projects ↗</a>
      </div>

      <div class="projects-grid">
        {
          projects.map((project) => (
            <article class="project-card">
              <div class="eyebrow">{project.tag}</div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                {project.label} ↗
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Writing and ideas -->
    <section class="light">
      <div class="container section">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Things I write about</div>
            <h2>Writing & Ideas</h2>
          </div>

          <a class="inline-link" href="/writing/">All writing ↗</a>
        </div>

        <div class="posts-grid">
          {
            posts.map((post, i) => (
              <a class="post-card" href={post.url}>
                <div class={`post-art art-${i % 2}`}>
                  {i % 2 === 0 ? "G = (V, E)" : "min f(x)"}
                </div>

                <div class="post-content">
                  <div class="eyebrow">{post.frontmatter.category}</div>
                  <h3>{post.frontmatter.title}</h3>
                  <p>{post.frontmatter.description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>
