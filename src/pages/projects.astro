import Base from '../layouts/Base.astro';
const projects=[
{tag:'Graph Algorithms',title:'Minimum Spanning Trees',description:"Implementing and comparing Prim's and Kruskal's algorithms.",url:'https://github.com/PeaceAyegba/MST-Algorithms',label:'View project'},
{tag:'Machine Learning',title:'House Rent Prediction',description:'Regression modelling and exploratory data analysis.',url:'https://github.com/PeaceAyegba/house-rent-prediction',label:'View project'},
