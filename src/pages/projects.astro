
---
import Base from '../layouts/Base.astro';

const projects = [
  {
    tag: 'Graph Algorithms',
    title: 'Minimum Spanning Trees',
    description: "Implementing and comparing Prim's and Kruskal's algorithms.",
    url: 'https://github.com/PeaceAyegba/MST-Algorithms',
    label: 'View project',
  },
  {
    tag: 'Machine Learning',
    title: 'House Rent Prediction',
    description: 'Regression modelling and exploratory data analysis.',
    url: 'https://github.com/PeaceAyegba/house-rent-prediction',
    label: 'View project',
  },
  {
    tag: 'NLP',
    title: 'Transformer Fine-Tuning',
    description: 'RoBERTa for text classification.',
    url: 'https://www.kaggle.com/code/peace1a/roberta-base',
    label: 'View notebook',
  },
];

const contributions = [
  {
    tag: 'Technical Review · Software Sustainability Institute',
    title: 'Using AI for Humanities Research Software',
    description:
      'Contributed a technical review of a guide exploring the use of AI tools in humanities research.',
    url: 'https://www.software.ac.uk/guide/using-ai-humanities-research-software',
    label: 'Read the guide',
  },
];
---

<Base title="Personal Projects | Peace Ayegba">
  <header class="inner-banner">
    <div class="container inner-banner-grid">
      <div>
        <div class="eyebrow">Selected work</div>
        <h1>Personal Projects</h1>
      </div>

      <p>
        Some of the algorithms and machine learning projects I've worked on.
      </p>
    </div>
  </header>

  <main class="container inner-main">
    <!-- Personal projects -->
    <div class="projects-grid">
      {
        projects.map((project) => (
          <article class="project-card">
            <div class="eyebrow">{project.tag}</div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>

            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.label} ↗
            </a>
          </article>
        ))
      }
    </div>

    <!-- Reviews and other contributions -->
    <section class="contributions">
      <h2>Reviews & Contributions</h2>

      <div class="contributions-grid">
        {
          contributions.map((item) => (
            <article class="contribution-card">
              <div class="eyebrow">{item.tag}</div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>

              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.label} ↗
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  .contributions {
    margin-top: 55px;
    padding-top: 35px;
    border-top: 1px solid #e9e6df;
  }

  .contributions h2 {
    margin-bottom: 25px;
    color: #152e45;
    font-family: Georgia, serif;
    font-size: 30px;
    font-weight: 400;
  }

  .contributions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .contribution-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 25px;
    border: 1px solid #e9e6df;
    border-top: 3px solid #bd965f;
    background: #faf9f5;
  }

  .contribution-card h3 {
    margin: 0;
    color: #152e45;
    font-family: Georgia, serif;
    font-size: 21px;
    font-weight: 400;
  }

  .contribution-card p {
    flex: 1;
    margin: 0;
    color: #657581;
    font-size: 14px;
    line-height: 1.8;
  }

  .contribution-card a {
    color: #926b3a;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .contribution-card a:hover {
    text-decoration: underline;
  }

  @media (max-width: 650px) {
    .contributions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
