---
import Base from './Base.astro';
const {frontmatter}=Astro.props;
---
<Base title={`${frontmatter.title} | Peace Ayegba`} description={frontmatter.description}><header class="inner-banner"><div class="container inner-banner-grid"><div><div class="eyebrow">{frontmatter.category} · {frontmatter.date}</div><h1>{frontmatter.title}</h1></div><p>{frontmatter.description}</p></div></header><article class="article container"><a class="inline-link" href="/writing/">← All writing</a><div class="article-content"><slot/></div></article></Base>
